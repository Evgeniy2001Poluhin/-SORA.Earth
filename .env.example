# ===================================
# SORA.Earth AI Platform - Environment Configuration
# ===================================
# Copy this file to .env and fill in your secrets
# NEVER commit .env to git!

# === Environment ===
SORA_ENV=development  # Options: development, staging, production

# === Database ===
POSTGRES_USER=sora
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_min_32_chars
POSTGRES_DB=sora_earth
DATABASE_URL=postgresql://sora:CHANGE_ME_strong_random_password_min_32_chars@postgres:5432/sora_earth

# === Security & Authentication ===
# JWT Secret: Generate with: openssl rand -hex 32
SORA_JWT_SECRET=CHANGE_ME_64_random_chars_generate_with_openssl_rand_hex_32

# Admin API key: Generate with: openssl rand -hex 32
SORA_ADMIN_TOKEN=CHANGE_ME_admin_token_64_chars

# Default user passwords (REQUIRED in production, optional in dev)
# Generate strong passwords and store in password manager
SORA_DEFAULT_ADMIN_PASSWORD=CHANGE_ME_admin_password_min_16_chars
SORA_DEFAULT_ANALYST_PASSWORD=CHANGE_ME_analyst_password_min_16_chars
SORA_DEFAULT_VIEWER_PASSWORD=CHANGE_ME_viewer_password_min_16_chars

# === External APIs ===
# Optional LLM for the Co-Pilot. Off by default, and the platform is fully
# functional without it: the verdict, probability, drivers and risks come from
# the model and from templates. An LLM only rewrites the prose of
# executive_summary and answers follow-up questions.
#
# OpenAI and OpenRouter are no longer configured. Their endpoints answer, but
# the accounts cannot be administered from here -- a key cannot be created,
# rotated or revoked -- and holding a credential you cannot revoke is a
# standing risk in exchange for nicer wording.
#
# There is no default endpoint. Enabling the LLM means naming where it lives.
#
# Self-hosted, nothing leaves the host. The address depends on where the app
# runs, and getting this wrong is the usual first mistake -- localhost inside a
# container is the container, not the host:
#
#   app on the host, Ollama on the host    http://localhost:11434/v1
#   both as Compose services               http://ollama:11434/v1
#   app in Docker, Ollama on the host      http://host.docker.internal:11434/v1
#
#   COPILOT_LLM_ENABLED=true
#   COPILOT_LLM_BASE_URL=http://ollama:11434/v1
#   COPILOT_LLM_MODEL=qwen2.5:7b-instruct
#   COPILOT_LLM_API_KEY=ollama          # the client requires a value; Ollama ignores it
#
# Managed, any OpenAI-compatible provider:
#   COPILOT_LLM_ENABLED=true
#   COPILOT_LLM_BASE_URL=<provider endpoint, https>
#   COPILOT_LLM_MODEL=<provider model id>
#   COPILOT_LLM_API_KEY=<from a secret, never a literal here>
COPILOT_LLM_ENABLED=false

# OpenAQ Air Quality API Key (optional)
OPENAQ_API_KEY=

# === MLflow ===
MLFLOW_TRACKING_URI=http://host.docker.internal:5556

# === Observability (Optional) ===
# Sentry for error tracking
SENTRY_DSN=

# Grafana admin password
GRAFANA_PASSWORD=CHANGE_ME_grafana_password

# === Drift Alerts (Optional) ===
# Slack webhook for drift alerts
SLACK_WEBHOOK_URL=

# Telegram bot for alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (SMTP)
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Drift detection threshold (PSI)
DRIFT_PSI_THRESHOLD=0.2

# ===================================
# SECURITY CHECKLIST FOR PRODUCTION:
# ===================================
# [ ] SORA_ENV=production
# [ ] SORA_JWT_SECRET is 64+ random chars (not default)
# [ ] SORA_ADMIN_TOKEN is 64+ random chars (not default)
# [ ] POSTGRES_PASSWORD is 32+ random chars
# [ ] All default user passwords set to strong values
# [ ] COPILOT_LLM_API_KEY set only if COPILOT_LLM_ENABLED=true
# [ ] .env file has permissions 600 (chmod 600 .env)
# [ ] .env is in .gitignore and NOT in git history
