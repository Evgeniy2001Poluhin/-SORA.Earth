{
  "dashboard": {
    "title": "SORA Forecasting Models",
    "tags": ["forecasting", "lstm", "prophet", "mlops"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "LSTM Activation Status",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "forecast_lstm_active",
            "legendFormat": "LSTM Active",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "background",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "0", "text": "Inactive"},
              {"type": "value", "value": "1", "text": "Active"}
            ],
            "thresholds": {
              "steps": [
                {"value": 0, "color": "orange"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Sample Count Progress",
        "type": "gauge",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "forecast_sample_count",
            "legendFormat": "Samples",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 60,
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 30, "color": "yellow"},
                {"value": 60, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Days Until LSTM Activation",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "forecast_days_until_lstm",
            "legendFormat": "Days Remaining",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "value",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "d",
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 30, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Model Weights Over Time",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "forecast_lstm_weight",
            "legendFormat": "LSTM Weight",
            "refId": "A"
          },
          {
            "expr": "forecast_prophet_weight",
            "legendFormat": "Prophet Weight",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1
          }
        }
      },
      {
        "id": 5,
        "title": "Sample Count Over Time",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "forecast_sample_count",
            "legendFormat": "Training Samples",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 60, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Forecast Request Rate",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 10, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "rate(forecast_requests_total[5m])",
            "legendFormat": "Requests/sec",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        }
      },
      {
        "id": 7,
        "title": "Model Comparison (MAE)",
        "type": "bargauge",
        "gridPos": {"x": 12, "y": 10, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "forecast_model_mae{model=\"prophet\"}",
            "legendFormat": "Prophet MAE",
            "refId": "A"
          },
          {
            "expr": "forecast_model_mae{model=\"lstm\"}",
            "legendFormat": "LSTM MAE",
            "refId": "B"
          },
          {
            "expr": "forecast_model_mae{model=\"ensemble\"}",
            "legendFormat": "Ensemble MAE",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 3, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      }
    ],
    "refresh": "10s",
    "time": {"from": "now-1h", "to": "now"},
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
    },
    "annotations": {
      "list": [
        {
          "name": "LSTM Activation",
          "datasource": "Prometheus",
          "expr": "changes(forecast_lstm_active[1m]) > 0",
          "tagKeys": "activation",
          "titleFormat": "LSTM Activation Event",
          "textFormat": "LSTM model activated in ensemble"
        }
      ]
    }
  }
}
