{
  "title": "SORA Forecasting Models",
  "tags": [
    "forecasting",
    "lstm",
    "prophet",
    "mlops"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "LSTM Activation Status",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sora_forecast_lstm_active{job=\"sora-app\"}",
          "legendFormat": "LSTM Active",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "value": "0",
              "text": "Inactive"
            },
            {
              "type": "value",
              "value": "1",
              "text": "Active"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "orange"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Sample Count Progress",
      "type": "gauge",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sora_forecast_samples_total{job=\"sora-app\"}",
          "legendFormat": "Samples",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 60,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 30,
                "color": "yellow"
              },
              {
                "value": 60,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Days Until LSTM Activation",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sora_forecast_days_remaining{job=\"sora-app\"}",
          "legendFormat": "Days Remaining",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 10,
                "color": "yellow"
              },
              {
                "value": 30,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Sample Count Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "sora_forecast_samples_total{job=\"sora-app\"}",
          "legendFormat": "Training Samples",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 60,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Forecast Request Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"sora-app\", handler=\"/api/v1/forecast\"}[5m]))",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 7,
      "title": "Ensemble MAE by metric",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sora_forecast_mae_current{job=\"sora-scheduler\", model=\"ensemble\"}",
          "legendFormat": "{{metric}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 3,
                "color": "yellow"
              },
              {
                "value": 5,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "description": "Only the ensemble's MAE is exported (sora_forecast_mae_current, written by the scheduler's auto_pretrain_forecast every six hours, absent for up to six hours after a restart). Prophet and LSTM MAE are not exported under any name, so a model comparison cannot be drawn from Prometheus."
    }
  ],
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "LSTM Activation",
        "datasource": "Prometheus",
        "expr": "changes(sora_forecast_lstm_active{job=\"sora-app\"}[1m]) > 0",
        "tagKeys": "activation",
        "titleFormat": "LSTM Activation Event",
        "textFormat": "LSTM model activated in ensemble"
      }
    ]
  },
  "id": null,
  "uid": "forecasting-models",
  "version": 0,
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "schemaVersion": 38
}