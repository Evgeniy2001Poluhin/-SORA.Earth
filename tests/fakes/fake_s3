#!/usr/bin/env python3
"""A local stand-in for the AWS CLI, covering only the verbs the scripts use.

Tests must exercise the real upload ordering and the real completion contract
without a network or credentials. Faking at the client boundary keeps the
scripts under test unmodified -- they call the same commands they would in
production, and BACKUP_S3_CLIENT decides who answers.

FAKE_S3_LOG names a file every invocation is appended to, argv verbatim.

The bucket is a directory named by FAKE_S3_ROOT. FAKE_S3_FAIL_ON, when set to a
substring, makes any upload whose key contains it fail -- which is how a partial
upload is staged.
"""
import os
import shutil
import sys
from pathlib import Path

ROOT = Path(os.environ.get("FAKE_S3_ROOT", "/tmp/fake-s3"))
FAIL_ON = os.environ.get("FAKE_S3_FAIL_ON", "")


def local_of(uri: str) -> Path:
    return ROOT / uri.removeprefix("s3://")


def main(argv):
    # Every invocation, verbatim, including the arguments the wrapper strips
    # below. A test asserting on upload *order* or on the endpoint reaching the
    # client needs the calls themselves, not their effects.
    log = os.environ.get("FAKE_S3_LOG")
    if log:
        with open(log, "a") as fh:
            fh.write(" ".join(argv) + "\n")

    args = [a for a in argv if a != "--endpoint-url" and not a.startswith("http")]
    if not args:
        return 2
    if args[0] == "s3" and args[1] == "cp":
        src, dst = args[2], args[3]
        if FAIL_ON and FAIL_ON in dst:
            print(f"fake_s3: refusing {dst}", file=sys.stderr)
            return 1
        if dst.startswith("s3://"):
            target = local_of(dst)
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(src, target)
        else:
            source = local_of(src)
            if not source.exists():
                print(f"fake_s3: missing {src}", file=sys.stderr)
                return 1
            shutil.copy(source, dst)
        return 0
    if args[0] == "s3api" and args[1] == "head-object":
        key = args[args.index("--key") + 1]
        bucket = args[args.index("--bucket") + 1]
        path = ROOT / bucket / key
        if not path.exists():
            return 1
        print('{ "ContentLength": %d }' % path.stat().st_size)
        return 0
    if args[0] == "s3" and args[1] == "ls":
        base = local_of(args[2])
        if not base.exists():
            return 0
        for f in sorted(base.rglob("*")):
            if f.is_file():
                print(f"2026-01-01 00:00:00 {f.stat().st_size} {f.relative_to(ROOT)}")
        return 0
    if args[0] == "s3" and args[1] == "rm":
        target = local_of(args[2])
        if target.exists():
            shutil.rmtree(target, ignore_errors=True)
        return 0
    print(f"fake_s3: unsupported {args}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
