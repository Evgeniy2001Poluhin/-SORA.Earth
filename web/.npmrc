# `engines` is advisory by default: npm prints a warning and installs anyway,
# which is how a developer on the wrong Node discovers it from a red CI run
# instead of from the install.
#
# Measured on 2026-09-03: a test passed on Node 24 and failed on Node 20 because
# undici's Response rejects jsdom's Blob on the older one. Nothing local said the
# versions differed.
engine-strict=true
