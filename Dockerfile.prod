# Stage 0: SPA build
#
# The frontend used to be built by hand and part of its output committed, which
# left a tracked index.html pointing at hashed bundles that were never in git.
# A clean clone could not serve a working page, and production only worked
# because the host directory was bind-mounted in. Building here makes the image
# the source of truth (issue #21).
FROM node:20-slim AS spa

WORKDIR /src

# Manifests first, so npm ci re-runs when dependencies change rather than on
# every source edit.
COPY web/package.json web/package-lock.json ./web/
RUN cd web && npm ci

COPY web/ ./web/
# vite.config.ts points outDir at ../app/static/spa, so the bundle lands in
# /src/app/static/spa.
RUN cd web && npm run build

# Stage 1: builder
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/

# CPU-only PyTorch (~190 MB вместо ~2.5 GB CUDA) [web:584]
RUN pip install --no-cache-dir --user \
            --index-url https://download.pytorch.org/whl/cpu \
            torch==2.8.0
    
# Остальные зависимости (с PyPI)
COPY requirements-prod.txt /tmp/

# CPU-only PyTorch (~190 MB вместо ~2.5 GB CUDA) [web:584]
RUN pip install --no-cache-dir --user \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.8.0

RUN pip install --no-cache-dir --prefer-binary --user -r /tmp/requirements-prod.txt \
    && pip install --no-cache-dir --user gunicorn "uvicorn[standard]" "psycopg[binary]"
           
# Stage 2: runtime
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    PATH=/home/app/.local/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 curl tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 -s /bin/bash app

USER app
WORKDIR /app

COPY --from=builder --chown=app:app /root/.local /home/app/.local
COPY --chown=app:app app/         ./app/
# app/static/spa is excluded from the build context, so it arrives only from
# the SPA stage — never from whatever the person running the build happens to
# have lying around.
COPY --from=spa --chown=app:app /src/app/static/spa ./app/static/spa
COPY --chown=app:app data/        ./data/
COPY --chown=app:app run_scheduler.py ./
COPY --chown=app:app alembic.ini  ./
COPY --chown=app:app alembic/     ./alembic/
# Operational entry points. Their absence was not noticed until someone tried
# to run one on production: scripts/refresh_indicator_history.py is documented
# in its own module as *the* way to perform the first history refresh, and it
# was in the repository and not in the image (#99). Nothing else references
# scripts/ at runtime, so nothing failed until it was needed.
COPY --chown=app:app scripts/     ./scripts/
COPY --chown=app:app entrypoint.sh ./
RUN chmod +x ./entrypoint.sh

# The mount point for the `runtime_models` volume, created here so that Docker
# has an owner to copy.
#
# Docker initialises an empty named volume from the image directory it is
# mounted over, and that includes its ownership. When the path does not exist in
# the image there is nothing to copy from, so the volume's root stays owned by
# root -- while backend and scheduler run as `user: "1000:1000"`. The first
# thing either does at import is take the activation lock:
#
#     PermissionError: [Errno 13] Permission denied: '/app/runtime/.model-source.lock'
#       app/main.py:413        load_champion(recover_first=True)
#       app/model_source.py:155  os.open(_lock_path(), os.O_CREAT | os.O_RDWR)
#
# gunicorn then reports "Worker failed to boot", nginx answers 502, and the
# deployment refuses at exit 76. Measured on the first deployment carrying #191
# to a fresh server, 2026-09-02 -- the volume is new exactly once, so this could
# not appear until the phase 3 work first met an empty one.
#
# `mkdir` and not `VOLUME`: a VOLUME instruction would also declare an anonymous
# volume for anyone running the image without compose, which is a different and
# unwanted behaviour. The directory alone is what carries the ownership.
#
# It runs after `USER app`, so the directory is owned by app without a chown --
# and a chown is not available here anyway, since this stage has already dropped
# root.
RUN mkdir -p /app/runtime

EXPOSE 8000
# The grace period is measured, not guessed (#50).
#
# `app/main.py` unpickles the models at import -- torch, SHAP, the ensembles --
# and nothing answers on :8000 until that finishes, so no separation of
# liveness from readiness helps here: during the load there is no server to ask.
# The only question is how long the period is.
#
# Measured on production, 2026-08-14, from the container's own log:
#
#     11:08:33.878  container started
#     11:08:34.849  schema verified
#     11:08:35.501  gunicorn listening, workers booting
#     11:08:48.644  Application startup complete
#
# 14.8 seconds. Against the old 20s that is 5.2 seconds of margin -- and on the
# isolated stand where #50 was found the same image took past ninety, with three
# checks failing before it answered. The container was marked unhealthy while it
# was loading correctly, and anything reading that status was told the
# application was broken.
#
# 120s covers both with room. What it costs is diagnostic latency: a container
# that is genuinely broken stays `starting` for two minutes before it is called
# unhealthy. Under Compose neither status triggers an action, so that cost is
# paid by a reader and not by the deployment.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "./entrypoint.sh"]

# Stage 3: nginx
#
# nginx serves /assets/ itself (see nginx.conf) so that a missing bundle 404s
# instead of the backend's SPA catch-all answering with index.html. That means
# it needs the same build output the backend has, and it now takes it from the
# same stage rather than from a host directory.
#
# This stage is last, so `docker build` with no --target lands here. Both
# services in docker-compose.prod.yml name their target explicitly.
FROM nginx:1.27-alpine AS nginx-spa

COPY --from=spa /src/app/static/spa /usr/share/nginx/spa
