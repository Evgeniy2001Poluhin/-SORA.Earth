# Stage 0: SPA build
#
# The frontend used to be built by hand and part of its output committed, which
# left a tracked index.html pointing at hashed bundles that were never in git.
# A clean clone could not serve a working page, and production only worked
# because the host directory was bind-mounted in. Building here makes the image
# the source of truth (issue #21).
FROM node:20-slim AS spa

WORKDIR /src

# Manifests first, so npm ci re-runs when dependencies change rather than on
# every source edit.
COPY web/package.json web/package-lock.json ./web/
RUN cd web && npm ci

COPY web/ ./web/

# Without this the built site serves invented numbers.
#
# `web/src/api/mock.ts` decides at build time:
#
#     export const isMock =
#         import.meta.env.VITE_USE_MOCK === "1" || !import.meta.env.VITE_API_BASE;
#
# Vite substitutes an unset variable with `undefined`, so an image built without
# it ships `isMock === true` and eight endpoint modules -- evaluate, explain,
# calibration, driftBaseline, history, mlops, admin, report -- answer from
# canned data instead of the API.
#
# It is a switch and nothing else. `web/src/api/client.ts` hardcodes
# `const BASE = "/api/v1"`, so this value routes nothing; the deployment sets it
# to the same path so the two do not read as competing claims.
#
# What it looked like on production, 2026-09-03: the SHAP panel drew a beige
# rectangle captioned "SHAP Waterfall (mock)"; an ESG score of 79.5 and a
# success probability of 87.8% were produced without the model being asked; and
# the drift page showed "OBSERVATIONS 0 / NO BASELINE" beside "BASELINE 734
# samples / 7 feats" and 100% drift on four features -- the real API and the
# mock answering in the same view.
#
# The regression arrived with the move described above. The hand-built bundle
# was made in an environment that had the variable; the in-image build was not
# given it, and nothing failed loudly, because a mock is a working page.
#
# ---
#
# Declared with **no default**, on purpose.
#
# A default of `/api/v1` here would be production-safe and that is the problem:
# a caller who forgets to pass the argument gets a correct-looking image, and the
# deployment-configuration mistake is hidden rather than reported. The value
# belongs in the deployment description, so `docker-compose.prod.yml` sets it
# under `backend.build.args` where it can be read, and a build that does not
# supply it stops here.
#
# Missing and empty must behave identically -- fail closed -- so the check below
# rejects unset, empty and whitespace-only alike.
ARG VITE_API_BASE
ENV VITE_API_BASE=${VITE_API_BASE}

# The other half of the isMock expression, exposed only so CI can turn mocks on
# deliberately and watch the guard after `npm run build` reject the result.
# Nothing sets it in normal use, and a build that does still fails -- which is
# the property being demonstrated, not a way around it.
ARG VITE_USE_MOCK
ENV VITE_USE_MOCK=${VITE_USE_MOCK}

RUN if [ -z "$(printf '%s' "$VITE_API_BASE" | tr -d '[:space:]')" ]; then \
        echo "FATAL: VITE_API_BASE is unset, empty or whitespace." >&2; \
        echo "       web/src/api/mock.ts turns the whole frontend into canned" >&2; \
        echo "       data when it is absent. Pass it as a build arg; the" >&2; \
        echo "       deployment does so in docker-compose.prod.yml." >&2; \
        exit 1; \
    fi

# vite.config.ts points outDir at ../app/static/spa, so the bundle lands in
# /src/app/static/spa.
RUN cd web && npm run build

# The build is not allowed to be a mock. Vite inlines the flag, so the evidence
# is in the output and this reads it there rather than trusting the ENV above to
# have had the intended effect.
#
# `--include='*.js'` and not the whole directory. `vite.config.ts` sets
# `sourcemap: true`, and a source map carries the original text of the branch
# Vite removed -- so an unrestricted grep matches the mock string in
# ExplainPage-*.js.map on a build that is entirely correct, and fails it.
# Measured: with VITE_API_BASE set, the string appears in one .map and in no .js.
#
# The .map files are what a debugger reads and are never executed; the .js files
# are what runs, and they are what this asks about.
#
# Several markers, not one. Grepping for a single string is a check against one
# example: the first version looked only for the SHAP placeholder and would have
# passed a bundle still carrying the fabricated PDF report, which says
# "Score: 72.3 / 100" over a real timestamp and is handed to the user as a file.
#
#   (mock)        -- the convention every user-visible placeholder follows
#   mockEvaluate  -- the generator itself; it invents scores with Math.random()
#
# Measured on a correct build: none of these appear in any .js; building with
# VITE_USE_MOCK=1 puts them back, which is how CI proves this step can fail.
RUN for marker in '(mock)' 'mockEvaluate'; do \
        if grep -rqF --include='*.js' "$marker" /src/app/static/spa/assets/; then \
            echo "FATAL: the SPA bundle contains mock payloads (found: $marker);" >&2; \
            echo "       VITE_API_BASE did not reach the build." >&2; \
            exit 1; \
        fi; \
    done

# Stage 1: builder
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/

# CPU-only PyTorch (~190 MB вместо ~2.5 GB CUDA) [web:584]
RUN pip install --no-cache-dir --user \
            --index-url https://download.pytorch.org/whl/cpu \
            torch==2.8.0
    
# Остальные зависимости (с PyPI)
COPY requirements-prod.txt /tmp/

# CPU-only PyTorch (~190 MB вместо ~2.5 GB CUDA) [web:584]
RUN pip install --no-cache-dir --user \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.8.0

RUN pip install --no-cache-dir --prefer-binary --user -r /tmp/requirements-prod.txt \
    && pip install --no-cache-dir --user gunicorn "uvicorn[standard]" "psycopg[binary]"
           
# Stage 2: runtime
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    PATH=/home/app/.local/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 curl tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 -s /bin/bash app

USER app
WORKDIR /app

COPY --from=builder --chown=app:app /root/.local /home/app/.local
COPY --chown=app:app app/         ./app/
# app/static/spa is excluded from the build context, so it arrives only from
# the SPA stage — never from whatever the person running the build happens to
# have lying around.
COPY --from=spa --chown=app:app /src/app/static/spa ./app/static/spa
COPY --chown=app:app data/        ./data/
COPY --chown=app:app run_scheduler.py ./
COPY --chown=app:app alembic.ini  ./
COPY --chown=app:app alembic/     ./alembic/
# Operational entry points. Their absence was not noticed until someone tried
# to run one on production: scripts/refresh_indicator_history.py is documented
# in its own module as *the* way to perform the first history refresh, and it
# was in the repository and not in the image (#99). Nothing else references
# scripts/ at runtime, so nothing failed until it was needed.
COPY --chown=app:app scripts/     ./scripts/
COPY --chown=app:app entrypoint.sh ./
RUN chmod +x ./entrypoint.sh

EXPOSE 8000
# The grace period is measured, not guessed (#50).
#
# `app/main.py` unpickles the models at import -- torch, SHAP, the ensembles --
# and nothing answers on :8000 until that finishes, so no separation of
# liveness from readiness helps here: during the load there is no server to ask.
# The only question is how long the period is.
#
# Measured on production, 2026-08-14, from the container's own log:
#
#     11:08:33.878  container started
#     11:08:34.849  schema verified
#     11:08:35.501  gunicorn listening, workers booting
#     11:08:48.644  Application startup complete
#
# 14.8 seconds. Against the old 20s that is 5.2 seconds of margin -- and on the
# isolated stand where #50 was found the same image took past ninety, with three
# checks failing before it answered. The container was marked unhealthy while it
# was loading correctly, and anything reading that status was told the
# application was broken.
#
# 120s covers both with room. What it costs is diagnostic latency: a container
# that is genuinely broken stays `starting` for two minutes before it is called
# unhealthy. Under Compose neither status triggers an action, so that cost is
# paid by a reader and not by the deployment.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "./entrypoint.sh"]

# Stage 3: nginx
#
# nginx serves /assets/ itself (see nginx.conf) so that a missing bundle 404s
# instead of the backend's SPA catch-all answering with index.html. That means
# it needs the same build output the backend has, and it now takes it from the
# same stage rather than from a host directory.
#
# This stage is last, so `docker build` with no --target lands here. Both
# services in docker-compose.prod.yml name their target explicitly.
FROM nginx:1.27-alpine AS nginx-spa

COPY --from=spa /src/app/static/spa /usr/share/nginx/spa
